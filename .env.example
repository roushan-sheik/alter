# Application
PORT=5000

# Database (PostgreSQL running on the host machine)
# When running via Docker: use 'host.docker.internal' as host
# When running locally (go run / air): use 'localhost' as host

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=gotickets
# DSN="host=host.docker.internal user=postgres password=postgres dbname=gotickets port=5432 sslmode=disable TimeZone=Asia/Dhaka"

# Prod 
DSN=postgresql://neondb_owner:npg_8eSB0nsVFprc@ep-wandering-glitter-a73ny7sp-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT
JWT_ACCESS_TOKEN_SECRET="your_access_secret"
JWT_REFRESH_TOKEN_SECRET="your_refresh_secret"
JWT_ACCESS_TOKEN_EXPIRY="24h"
 
JWT_REFRESH_TOKEN_EXPIRY="720h"

 
# Notifications
FCM_SERVER_KEY="your_fcm_key"

# Subscriptions
APPLE_SHARED_SECRET="your_apple_secret"

# Media
CLOUDINARY_URL="cloudinary://my_key:my_secret@my_cloud_name"

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Email Setup (Gmail App Password)
SMTP_FROM_NAME="ZICK App"
SMTP_FROM_ADDRESS="your-email@gmail.com"
SMTP_APP_PASSWORD="your-16-char-app-password"

# Firebase (Social Login)
FIREBASE_PROJECT_ID="your_firebase_project_id"
GOOGLE_APPLICATION_CREDENTIALS="path/to/your/service-account.json"

# Admin Settings
ADMIN_EMAIL=admin@altar.com
ADMIN_PASSWORD=Admin1234

# Media Settings
MAX_UPLOAD_SIZE_MB=200
